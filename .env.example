ADMIN_SECRET=change-me
SESSION_SECRET=change-me-too
APP_BASE_URL=https://tutor.edu.rennix.ai
# Must exactly match tutor-service's LTI_BRIDGE_SECRET.
LTI_BRIDGE_SECRET=change-me-three
# Must exactly match tutor-service's TENANT_ADMIN_SECRET.
TENANT_ADMIN_SECRET=change-me-four
# Optional but recommended: encrypts this tool's own RSA private key at rest.
# Safe to add to an existing deployment -- the key stays plaintext until this
# is set, then gets transparently re-encrypted in place on the next boot.
KEY_ENCRYPTION_SECRET=change-me-five
# Postgres password used by docker-compose.yml (for both the postgres service
# and the DATABASE_URL it hands the lti service).
POSTGRES_PASSWORD=change-me-six
# Only when running outside docker compose (e.g. `npm start` / `npm test`):
# DATABASE_URL=postgres://rennix:change-me-six@localhost:5432/rennix_lti
# Signing-key rotation: automatic every KEY_ROTATION_DAYS; a retired key stays
# published in /lti/jwks for KEY_RETIRED_GRACE_HOURS so nothing in flight breaks.
KEY_ROTATION_DAYS=90
KEY_RETIRED_GRACE_HOURS=24
