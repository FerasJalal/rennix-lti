ADMIN_SECRET=change-me
SESSION_SECRET=change-me-too
APP_BASE_URL=https://tutor.edu.rennix.ai
# Must exactly match tutor-service's LTI_BRIDGE_SECRET.
LTI_BRIDGE_SECRET=change-me-three
# Must exactly match tutor-service's TENANT_ADMIN_SECRET.
TENANT_ADMIN_SECRET=change-me-four
# Optional but recommended: encrypts this tool's own RSA private key at rest.
# Safe to add to an existing deployment -- the key stays plaintext until this
# is set, then gets transparently re-encrypted in place on the next boot.
KEY_ENCRYPTION_SECRET=change-me-five
